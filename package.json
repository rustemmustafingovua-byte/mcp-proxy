{
  "name": "mcp-proxy",
  "version": "0.1.0",
  "description": "One endpoint in front of many MCP servers. mcp-proxy adds the things a shared MCP endpoint needs and a single server does not: a client key, per-client rate limits, an append-only request log, replay of past calls, and routing by server name.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-proxy": "bin/mcp-proxy.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp", "proxy", "rate-limiting", "observability", "openai-compatible", "agents", "security"
  ],
  "files": ["bin", "src", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "echo 'No build step required for mcp-proxy'",
    "lint": "node --check src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "viem": "^2.57.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rustemmustafingovua-byte/mcp-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/rustemmustafingovua-byte/mcp-proxy/issues"
  },
  "homepage": "https://github.com/rustemmustafingovua-byte/mcp-proxy",
  "funding": {
    "custom": [
      "https://github.com/sponsors/rustemmustafingovua-byte"
    ]
  }
}